# 환경변수 / API 키
.env
.env.*
!.env.example

# 의존성 / 빌드 산출물
node_modules/
dist/
build/
.next/

# OS / 에디터
.DS_Store
*.log

# python
__pycache__/
*.pyc
.pytest_cache/

# 런타임 캐시(디스크 영속 API 캐시 등) - 기기마다 다시 쌓이면 되는 데이터
# ⚠️ 디렉터리 자체를 제외하면(data/cache/) git이 그 안으로 내려가지 않아 아래 부정
#    규칙이 먹지 않는다. 그래서 '내용물'을 제외하고 필요한 것만 다시 넣는다.
data/cache/*

# ASOS 일자료 캐시는 **커밋한다**.
#   서버리스 인스턴스의 디스크는 휘발성이라, 캐시가 배포 번들에 없으면 인스턴스가 뜰
#   때마다 기상청에서 10년치를 새로 받아야 한다(25~60초). 그 대기가 챗봇 도구 예산을
#   다 먹어 "지금 조회가 안 돼요"만 반복됐다.
#   과거 연도의 일자료는 다시 바뀌지 않으므로 캐시가 아니라 사실상 정적 데이터다.
!data/cache/asos_daily/

# 백엔드 대용량 원천 데이터(선택) — 필요 시 주석 해제
# data/raw/hourly_temp_fruit_full.csv

# 챗봇 실행 로그(토큰 사용량) - 기기마다 다시 쌓이는 런타임 데이터
data/chat_usage.jsonl
.vercel
.env*

# Claude Code 로컬 설정 (인증키 등 로컬 값이 들어갈 수 있어 공유하지 않는다)
.claude/
