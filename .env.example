# 실시간 스코어링(backend/services/live_scoring.py) + Beomin_web 프론트엔드에 필요한
# API 키/설정 모음. 이 파일을 .env로 복사한 뒤 실제 발급받은 키 값을 채워 넣으세요.
# .env는 git에 올라가지 않으니(.gitignore) 팀원마다 각자 이 파일을 만들어야 합니다.
#
# ⚠️ data.go.kr은 계정당 공통 키 1쌍을 쓰지만, API 상품마다 "활용신청" 승인이 따로
#    필요합니다. ASOS_DALY_SERVICE_KEY/SOIL_EXAM_STAT_SERVICE_KEY는 대체로 자동승인(즉시)
#    이지만, KMA_SERVICE_KEY(기상청 단기예보)는 별도 심의를 거쳐 1~2일 걸릴 수 있어
#    이것만 빠뜨리기 쉽습니다 - 온도만 "결측"으로 나온다면 이 키부터 확인하세요.

# 기상청 단기예보 조회서비스 (https://www.data.go.kr/data/15084084/openapi.do)
KMA_SERVICE_KEY=

# 기상청 지상(종관) ASOS 일자료 조회서비스 (https://www.data.go.kr/data/15059093/openapi.do)
ASOS_DALY_SERVICE_KEY=
ASOS_DALY_BASE_URL=https://apis.data.go.kr/1360000/AsosDalyInfoService
ASOS_DALY_ENDPOINT=/getWthrDataList

# 농경지화학성 통계정보 (data.go.kr 15144685, 흙토람 SoilExamStat V2)
# 필수 파라미터: STDG_CD = 법정동코드(10자리)  ※ BJD_Code 아님!
SOIL_EXAM_STAT_SERVICE_KEY=
SOIL_EXAM_STAT_BASE_URL=https://apis.data.go.kr/1390802/SoilEnviron/SoilExamStat/V2
SOIL_EXAM_STAT_OP_PH=/getFarmExamPhInfo
SOIL_EXAM_STAT_OP_OM=/getFarmExamOmInfo
SOIL_EXAM_STAT_OP_AP=/getFarmExamApInfo
SOIL_EXAM_STAT_OP_KAL=/getFarmExamKalInfo
SOIL_EXAM_STAT_OP_CAL=/getFarmExamCalInfo
SOIL_EXAM_STAT_OP_MG=/getFarmExamMgInfo
SOIL_EXAM_STAT_OP_SA=/getFarmExamSaInfo

# 법정동코드 조회 (로컬 CSV, 국토교통부 20250805) - bjd_lookup.py가 이 CSV로
# 이름→STDG_CD(10자리) 즉시 변환
BJD_CODE_CSV=국토교통부_법정동코드_20250805.csv

# 네이버 지도 / 클라우드 플랫폼 키 (Beomin_web/RegionMap.html)
# Client ID: 웹 동적지도 JS에서 사용(클라이언트 노출 OK, 단 콘솔에서 도메인 제한 필수)
NAVER_MAP_CLIENT_ID=
# Client Secret: 서버 전용(지오코딩 등 REST API). 클라이언트 코드에 절대 넣지 말 것.
NAVER_MAP_CLIENT_SECRET=

# 네이버 뉴스검색 API (developers.naver.com, 지도 키와 별개, Beomin_web/news_server.py)
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NAVER_NEWS_ENDPOINT=https://openapi.naver.com/v1/search/news.json

# Anthropic Claude API (backend/chat_server.py 챗봇 전용, 서버에서만 사용)
# 발급: https://platform.claude.com 콘솔 > API Keys
# ⚠️ 콘솔에서 워크스페이스 월 지출 한도($25)를 먼저 걸어두세요. 코드 버그로
#    비용이 새는 걸 막는 유일한 하드 스톱입니다.
ANTHROPIC_API_KEY=
